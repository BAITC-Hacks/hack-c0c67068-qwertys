# Copy to .env locally. Never commit populated secrets or raw datasets.
RUN_STORE_PATH=.local/runs.sqlite3
# Health remains not_ready until actual model and weather inputs are present.
FORECAST_RUNNER=src.agent.runner:run_forecast
MODEL_DIR=models/production
WEATHER_RUNS_DIR=artifacts/c1/weather_runs
WEATHER_FETCH_POLICY=never
AGENT_MODE=deterministic
EVALUATION_PATH=coordination/research/C2/evaluation-v1.json
EVALUATION_V2_PATH=coordination/research/C2/evaluation-v2-posttest.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_SESSION_BUDGET_USD=1
